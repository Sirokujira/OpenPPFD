# 検証 (c) 群落の Beer-Lambert 減衰
#
# 黒葉 (散乱係数 omega = 0) の群落スラブ z = 0.4..0.8 m、LAI = 2.0、
# 葉群投影係数 G = 0.5。天井中心 (z = 1.0) の点光源から真下 (z = 0.2) へ
# 向かう光線はスラブを鉛直に貫くので、経路長 s = 0.4 m、
# 葉面積密度 a = 2.0/0.4 = 5.0 1/m、光学的厚さ = G a s = 0.5*5*0.4 = 1.0。
#
#     透過率 = exp(-G * LAI) = exp(-1) = 0.3678794              (厳密)
#
# check スクリプトは canopy 行を消した変種と中心セルの PPFD を比べて
# この比を判定する (幾何・単位換算がすべて相殺するので純粋な減衰の検証)。
# 壁は黒なので間接光は無い。

OpenPPFD 1 0
title = Beer-Lambert canopy extinction (analytic)

wavelength = 380 780 5
chamber    = 1.0 1.0 1.0
patchdiv   = 4 4

material = black     gray 0.0
material = blackleaf gray 0.0 0.0
wall     = all black

spectrum = na555 mono 555

led = 0.5 0.5 1.0 1.0 na555 beam 1 dir 0 0 -1

canopy = 0.8 0.4 2.0 0.5 blackleaf

target      = below 0.2 21 21
photoperiod = 16

end
