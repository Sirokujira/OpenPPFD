# 検証 (ac) IES の光度分布型 A / B (投光器・車載の座標)
#
# 黒いチャンバの中心 (0.5, 0.5, 0.5) に +x 向き (dir 1 0 0) の器具を置く。
# 配光は「|V| <= 30° で一定、|V| >= 40° で 0 (その間は線形)、H によらない」
# (bandA.ies は型 A、bandB.ies は型 B。どちらも 0..90° だけ書いて鏡映で展開)。
#
# 器具の座標 : x = 配光軸、z = 上 (+z)、y = z x x (= +y)。
#   型 A : V = 仰角 asin(z)、H = 方位角 atan2(y, x)     dΩ = cos V dV dH
#   型 B : V = 横軸 y まわりの面の回転角 atan2(z, x)、H = 緯度 asin(y)
#                                                       dΩ = cos H dH dV
# 正規化 ∫Î dΩ = 1 の分母 (帯の立体角) は型で違う :
#   Ω_A = π ∫ f(V) cos V dV = 3.5993146 sr
#   Ω_B = 2 ∫ f(V) dV       = 2.4434610 sr (= 4 x 35° [rad])
# 帯の中の向きでは Î = 1/Ω なので、距離 r = 0.3 m で光源を向く面の
#   E = Φ / (Ω r²) : 型 A 3.0870075、型 B 4.5472841 W/m²            (厳密)
#
#   axis : 配光軸の上 (0.8, 0.5, 0.5)
#   off  : 型 A の (H, V) = (60°, 25°) の向き。型 A では帯の中 (E = 3.0870075)、
#          型 B では同じ向きが V = atan2(sin25, cos25 cos60) = 43.0° になり
#          帯の外 (E = 0)。型 A と B の取り違えはここで必ず分かる。

OpenPPFD 1 0
title = IES photometric types A / B

wavelength = 380 780 5
chamber    = 1.0 1.0 1.0

material = black gray 0.0
wall     = all black

spectrum = na555 mono 555

led = 0.5 0.5 0.5 1.0 na555 ies bandA.ies dir 1 0 0

sensor = axis  0.8 0.505 0.495  0.8 0.495 0.495  0.8 0.505 0.505  1 1
sensor = off   0.630559495 0.736135679 0.631317017   0.632672587 0.739795661 0.622253940   0.639219749 0.731135679 0.631317017  1 1
target = floor 0.0 4 4
photoperiod = 16

end
