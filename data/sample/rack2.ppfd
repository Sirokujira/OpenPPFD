# 2 段ラック (遮蔽ありの実用例)
#
# 1.2 x 0.6 m の栽培面を 2 段。z = 0.45 の棚板 (トレイ、rho = 0.4) が
# 上下段を仕切り、各段に LED バーを 1 面ずつ置く。下段にはレタス相当の
# 群落 (LAI = 2.5) を入れてある。
#
# v1 では扱えなかった配置で、遮蔽判定付きの形態係数が要る :
#   - 下段の LED の光は棚板に遮られて上段には届かない
#   - 上段の照度は下段の LED を消しても 1 ビットも変わらない
#     (ppfd_check.sh がこれを判定に使う。棚板が断面いっぱいなので
#      パッチ対の可視率は 0 か 1 のどちらかにしかならず、この分離は厳密)
#
# patchdiv = 8 は z = 0.45 (= 0.9 * 4/8) が側壁パッチの境界に乗るよう
# 選んである。パッチが棚板をまたぐと、そのパッチ 1 枚を通して光が漏れる。
#
# quadrature を明示してあるのは、下段 LED を消した比較ケースで光源数が
# 変わっても直接光の求積分割が変わらないようにするため (既定は光源数から
# 自動で決まる)。

OpenPPFD 1 0
title = two-tier plant factory rack with a shelf

wavelength = 380 780 5

chamber    = 1.2 0.6 0.9
patchdiv   = 8 8
quadrature = 2

material = white gray 0.90
material = tray  gray 0.40

# レタス葉の分光光学特性 (反射:透過)
material = leaf table 400:0.05:0.02 450:0.05:0.02 500:0.06:0.03 550:0.15:0.10 600:0.08:0.04 660:0.05:0.02 690:0.10:0.08 700:0.22:0.20 720:0.42:0.42 780:0.47:0.47

wall = all  white
wall = zmin tray

# 段を仕切る棚板 (厚さ 0 の板 : 表裏 2 面がラジオシティに参加する)
occluder = shelf 0.0 1.2 0.0 0.6 0.45 0.45 tray

# 白色 + 赤の混合スペクトル (青 450 / 蛍光体 580 / 赤 660)
spectrum = wr sum 450 20 0.30 580 110 0.70 660 22 1.60

# 上段 (z = 0.85) と下段 (z = 0.40) の LED バー
array = 0.1 0.15 0.85 6 3 0.2 0.15 0.55 wr beam 1 input 1.2
array = 0.1 0.15 0.40 6 3 0.2 0.15 0.55 wr beam 1 input 1.2

# 下段の群落 (z = 0.05..0.25)
canopy = 0.25 0.05 2.5 0.5 leaf

target = tier2 0.50 13 7
target = tier1 0.25 13 7

photoperiod = 16
solver      = 500 1e-8

end
