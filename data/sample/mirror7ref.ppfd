# 検証 (u) mirror7.ppfd の参照解 : x と z の両方で 2 倍にした幾何
# 光源の鏡像 3 個と群落の箱の鏡像 3 個を実在のものとして置く。
# 鏡映面 (x = 1, z = 1) には壁が無い。x = 2 / z = 2 はそれぞれ xmin /
# zmin の鏡像なので黒のまま。

OpenPPFD 1 0
title = reference for mirror7 (doubled box)

wavelength = 380 780 5
chamber    = 2.0 1.0 2.0
patchdiv   = 8 8

material = black     gray 0.0
material = blackleaf gray 0.0 0.0

wall = all black

spectrum = na555 mono 555

led = 0.3 0.5 0.25 1.0 na555 iso
led = 1.7 0.5 0.25 1.0 na555 iso
led = 0.3 0.5 1.75 1.0 na555 iso
led = 1.7 0.5 1.75 1.0 na555 iso

canopy = 0.7 0.4 1.5 0.5 blackleaf  0.4 0.8 0.25 0.75
canopy = 0.7 0.4 1.5 0.5 blackleaf  1.2 1.6 0.25 0.75
canopy = 1.6 1.3 1.5 0.5 blackleaf  0.4 0.8 0.25 0.75
canopy = 1.6 1.3 1.5 0.5 blackleaf  1.2 1.6 0.25 0.75

target      = s 0.2 12 6 0 1 0 1
photoperiod = 16

end
