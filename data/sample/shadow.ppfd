# 検証 (h-2) 遮蔽物の影 (直接光の 2 値遮蔽)
#
# 完全吸収 (黒) のチャンバなので相互反射は無く、床面の放射照度は
# 点光源からの直接光だけで決まる。z = 0.5 に 0.2 x 0.2 m の板を置くと、
# 点光源 (0.5, 0.5, 0.9) からの投影で床面 (z = 0) に本影ができる。
#
#   投影倍率 = 0.9 / (0.9 - 0.5) = 2.25
#   本影     = 中心 (0.5, 0.5)、半幅 0.1 * 2.25 = 0.225
#            -> x, y in [0.275, 0.725]
#
# 11 x 11 セルなのでセル中心は (i + 0.5)/11。
#   ix = 5 (x = 0.5)     : 本影の中     -> PPFD = 0 (厳密)
#   ix = 0 (x = 0.04545) : 影の外       -> E = (Phi/pi) h^2/(h^2+r^2)^2
#                                          h = 0.9, r = 0.4545455
#
# 遮蔽があっても全放射束は表面 (壁 + 板) に吸収される。ただし影の境界で
# 被積分関数が不連続になるのでパッチ求積の収束が O(1/msub) まで落ちる。
# 境界のパッチは自動で細分されるが、それでも closure error は 1e-4 台が
# 限界 (形態係数ではなく直接光の求積の限界)。quadrature を上げてある。

OpenPPFD 1 0
title = umbra cast by an occluder (analytic)

wavelength = 380 780 5
chamber    = 1.0 1.0 1.0
patchdiv   = 6 6
quadrature = 6

material = black gray 0.0
wall     = all black

occluder = plate 0.4 0.6 0.4 0.6 0.5 0.5 black

spectrum = na555 mono 555

led = 0.5 0.5 0.9 1.0 na555 beam 1 dir 0 0 -1

target      = floor 0.0 11 11
photoperiod = 16

end
