# 検証 (s) 任意の向きの測定面 (sensor)
#
# 黒いチャンバ 1 x 1 x 1 の中心 (0.5, 0.5, 0.5) に等方点光源 1 W @ 555 nm。
# 壁が黒いので間接光は無く、どの面も直接光の解析解
#
#     E = Phi/(4 pi) * (n . (S - x)) / d^3      (n . (S - x) > 0 のときだけ)
#
# に一致する (S = 光源、x = セル中心、n = 受光面の法線)。
#
#   wall : 鉛直、-x 向き (光源の側)、中心 (0.9, 0.5, 0.3)
#          S - x = (-0.4, 0, 0.2), d^2 = 0.2, n.(S-x) = 0.4
#          PPFD = 0.0795775 * 0.4 / 0.2^1.5 * 4.6394372 = 1.6510888  (厳密)
#   down : 水平、下向き、光源の下 (中心 (0.5, 0.5, 0.2))
#          光源は受光面の裏側にあるので 0                         (厳密)
#   ceil : 水平、下向き、光源の上 (中心 (0.5, 0.5, 0.8))
#          d = 0.3, 正対 : PPFD = 0.0795775 / 0.09 * 4.6394372 = 4.1021631 (厳密)
#
# 受光するのは (p1 - p0) x (p3 - p0) の側。wall は eu = +z, ev = +y なので
# eu x ev = -x、down / ceil は eu = +y, ev = +x なので -z を向く。

OpenPPFD 1 0
title = oriented sensors (analytic direct light)

wavelength = 380 780 5
chamber    = 1.0 1.0 1.0
patchdiv   = 4 4

material = black gray 0.0
wall     = all black

spectrum = na555 mono 555

led = 0.5 0.5 0.5 1.0 na555 iso

target = floor 0.1 1 1
sensor = wall  0.9 0.4 0.2  0.9 0.4 0.4  0.9 0.6 0.2  1 1
sensor = down  0.4 0.4 0.2  0.4 0.6 0.2  0.6 0.4 0.2  1 1
sensor = ceil  0.4 0.4 0.8  0.4 0.6 0.8  0.6 0.4 0.8  1 1
photoperiod = 16

end
