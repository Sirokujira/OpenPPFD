# 検証 (y) mirror10.ppfd の参照解 : z で鏡映して 2 倍にした幾何。
# 群落の鏡像 (z 1.5..1.8) と光源の鏡像 (z 1.15) を実在のものとして置く。
# 上面 (z = 2) は床の鏡像なので白。黒い側壁の分割は面ごとの div で
# 実チャンバと同じ密度 (z 方向 0.125 m) にそろえる。2 枚のスラブは棚板なしで
# 向かい合う (面どうしの拡散光のやりとりでつながる)。

OpenPPFD 1 0
title = reference for mirror10 (doubled in z)
wavelength = 380 780 5
chamber    = 1.0 1.0 2.0
patchdiv   = 8 8
material = black  gray 0.0
material = white  gray 0.6
material = leaf   gray 0.25 0.25
wall = all  black
wall = xmin black div 8 16
wall = xmax black div 16 8
wall = ymin black div 16 8
wall = ymax black div 8 16
wall = zmin white
wall = zmax white
spectrum = na555 mono 555
led = 0.4 0.5 0.85 1.0 na555 iso
led = 0.4 0.5 1.15 1.0 na555 iso
canopy = 0.5 0.2 1.5 0.5 leaf
canopy = 1.8 1.5 1.5 0.5 leaf
leafscatter = on
target = above 0.7 6 6
target = mid   0.35 6 6
target = below 0.1 6 6
photoperiod = 16
solver      = 500 1e-10
end
